#BlueJ class context
comment0.target=Warehouse
comment0.text=\r\n\ Class\ for\ Warehouses\ with\ loading\ docks,\ queued\ trucks,\ and\ inventory\r\n\r\n\ @author\ Conrad\ Hahn\r\n\ @version\ 5/18/2025\r\n
comment1.params=x\ y\ docks
comment1.target=Warehouse(int,\ int,\ int)
comment1.text=\r\n\ creates\ a\ warehouse\ at\ x,y\ with\ a\ number\ of\ docks\r\n\r\n\ @param\ x\ x-coordinate\ on\ map\r\n\ @param\ y\ y-coordinate\ on\ map\r\n\ @param\ docks\ number\ of\ loading\ docks\r\n
comment2.params=
comment2.target=int\ getId()
comment2.text=\r\n\ gets\ this\ warehouses\ ID\r\n\r\n\ @return\ warehouse\ ID\r\n
comment3.params=
comment3.target=int\ getX()
comment3.text=\r\n\ gets\ x-coordinate\r\n\r\n\ @return\ x\ position\r\n
comment4.params=
comment4.target=int\ getY()
comment4.text=\r\n\ gets\ y-coordinate\r\n\r\n\ @return\ y\ position\r\n
comment5.params=
comment5.target=void\ action()
comment5.text=\r\n\ serves,\ up\ to\ the\ number\ of\ docks,\ trucks\ in\ first\ in\ first\ out\ order\r\n
comment6.params=
comment6.target=int\ log_status()
comment6.text=\r\n\ logs\ this\ warehouses\ state\ to\ the\ global\ log.\r\n\r\n\ @return\ this\ warehouses\ ID\ if\ successful,\ -1\ otherwise\r\n
comment7.params=t
comment7.target=void\ arrive(Truck)
comment7.text=\r\n\ adds\ a\ truck\ to\ the\ waiting\ queue\r\n\r\n\ @param\ t\ the\ truck\ arriving\r\n
comment8.params=s
comment8.target=void\ addShipment(Shipment)
comment8.text=\r\n\ adds\ a\ shipment\ to\ inventory\r\n\r\n\ @param\ s\ the\ shipment\ to\ store\r\n
comment9.params=
comment9.target=Shipment\ removeShipment()
